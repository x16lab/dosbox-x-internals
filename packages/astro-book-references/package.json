{
  "name": "astro-book-references",
  "version": "0.1.0",
  "description": "Astro + MDX integration for book-style publishing: automatic chapter and section numbering, stable {#section-id} anchors, and @chapter() / @section() cross-references.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "astro": "^7.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/unist": "^3.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-rehype": "^11.0.0",
    "typescript": "^5.6.0",
    "vfile": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
