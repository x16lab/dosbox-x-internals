---
interface Props {
  title?: string;
  year?: string;
}

const { title, year } = Astro.props;
---

<aside class="historical-note" aria-label={title || 'Historical Note'}>
  <div class="note-header">
    <span class="note-icon">&#9733;</span>
    <span class="note-label">{title || 'Historical Note'}</span>
    {year && <span class="note-year">{year}</span>}
  </div>
  <div class="note-body">
    <slot />
  </div>
</aside>

<style>
  .historical-note {
    margin: calc(var(--baseline) * 1.5) 0;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .note-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem var(--baseline);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-soft);
  }

  .note-icon {
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .note-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .note-year {
    margin-left: auto;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .note-body {
    padding: var(--baseline);
  }

  .note-body :global(p) {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    line-height: 1.7;
    font-style: italic;
  }

  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
